#!/usr/bin/env sh
# Gradle wrapper bootstrap: downloads gradle if needed
APP_HOME="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_PROPS="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"
DIST_URL=$(grep distributionUrl "$WRAPPER_PROPS" | cut -d= -f2- | sed 's/\\:/:/g')
DIST_ZIP="$APP_HOME/.gradle-dl/gradle-dist.zip"
GRADLE_HOME="$APP_HOME/.gradle-dl/gradle-8.5"
if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
  mkdir -p "$APP_HOME/.gradle-dl"
  echo "Downloading Gradle 8.5..."
  curl -L -o "$DIST_ZIP" "$DIST_URL" || wget -O "$DIST_ZIP" "$DIST_URL"
  unzip -q -o "$DIST_ZIP" -d "$APP_HOME/.gradle-dl"
fi
exec "$GRADLE_HOME/bin/gradle" "$@"
